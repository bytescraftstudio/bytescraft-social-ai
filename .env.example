# ================================================================
# BytesCraft Social AI Studio - Environment Configuration
# ================================================================
# All values can also be configured directly in the app via the
# "API Settings" modal in the top navigation bar.

# 1. Google Gemini AI API (Script & Copywriting Engine)
# Get your free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-1.5-flash

# 2. Meta Graph API (Facebook Page & Instagram Business)
# Generated from Meta for Developers (developers.facebook.com)
VITE_META_ACCESS_TOKEN=
VITE_FACEBOOK_PAGE_ID=
VITE_INSTAGRAM_ACCOUNT_ID=

# 3. LinkedIn Community API
# Generated from LinkedIn Developer Network (developer.linkedin.com)
VITE_LINKEDIN_ACCESS_TOKEN=
VITE_LINKEDIN_ORGANIZATION_ID=
